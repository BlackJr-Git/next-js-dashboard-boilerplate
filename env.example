# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Site Information
NEXT_PUBLIC_SITE_NAME="Your App Name"
NEXT_PUBLIC_SITE_TITLE="Your App - Modern Web Application"
NEXT_PUBLIC_SITE_DESCRIPTION="A modern web application built with Next.js, TypeScript, and Tailwind CSS."
NEXT_PUBLIC_SITE_URL="https://yourapp.com"

# API Configuration
NEXT_PUBLIC_API_URL="https://api.yourapp.com"

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL="contact@yourapp.com"
NEXT_PUBLIC_CONTACT_PHONE="+1 (555) 123-4567"
NEXT_PUBLIC_CONTACT_ADDRESS="123 Main St, City, State 12345"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourapp.com"

# Social Media Links (optional - remove unused ones)
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/yourapp"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourapp"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/yourapp"
NEXT_PUBLIC_X_URL="https://x.com/yourapp"
NEXT_PUBLIC_GITHUB_URL="https://github.com/BlackJr-Git/next-js-dashboard-boilerplate"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/yourapp"

# Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Authentication (if using NextAuth.js or similar)
NEXTAUTH_URL="https://yourapp.com"
NEXTAUTH_SECRET="your-secret-key-here"

# Database (if applicable)
DATABASE_URL="postgresql://username:password@localhost:5432/yourapp"

# Third-party API Keys (keep these secret - don't use NEXT_PUBLIC_ prefix)
STRIPE_SECRET_KEY="sk_test_..."
OPENAI_API_KEY="sk-..."
